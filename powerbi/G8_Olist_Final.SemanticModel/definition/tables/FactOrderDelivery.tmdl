	column DeliveredDateKey
		dataType: int64
		isHidden
		lineageTag: e6da7629-f7f7-422a-b97d-de1201390e20
		sourceColumn: DeliveredDateKey

	column EstimatedDeliveryDateKey
		dataType: int64
		isHidden
		lineageTag: 91b08340-e716-475f-ab9d-18f75467f091
		sourceColumn: EstimatedDeliveryDateKey

	column DeliveryDays
		dataType: int64
		lineageTag: c428efa3-5397-4f98-87d9-79bd409f7590
		sourceColumn: DeliveryDays

	column DelayDays
		dataType: int64
		lineageTag: dc244bc7-0204-4134-b5c6-c481f5646d96
		sourceColumn: DelayDays

	column IsDelivered
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: e70b7af4-5929-4d49-b2e5-369e1d6c5027
		summarizeBy: none
		sourceColumn: IsDelivered

		annotation SummarizationSetBy = Automatic

	column IsCancelled
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 12613b79-1375-48b6-ba5a-f2ef4416dc16
		summarizeBy: none
		sourceColumn: IsCancelled

		annotation SummarizationSetBy = Automatic

	column IsOnTime
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 821e861e-9dd1-42cc-953f-1d8f29b683ab
		summarizeBy: none
		sourceColumn: IsOnTime

		annotation SummarizationSetBy = Automatic

	column ReviewScore
		dataType: double
		lineageTag: 393a64d5-69a6-451e-9500-d95660a760cb
		summarizeBy: sum
		sourceColumn: ReviewScore

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column OrderStatus
		dataType: string
		lineageTag: 0e0c84db-4c42-499b-944f-4a4b3a101455
		sourceColumn: OrderStatus

	column PromiseBufferDays = VAR dk = 'FactOrderDelivery'[DeliveredDateKey] VAR ek = 'FactOrderDelivery'[EstimatedDeliveryDateKey] RETURN IF(NOT ISBLANK(dk) && NOT ISBLANK(ek) && 'FactOrderDelivery'[IsDelivered], DATEDIFF(DATE(INT(dk / 10000), MOD(INT(dk / 100), 100), MOD(dk, 100)), DATE(INT(ek / 10000), MOD(INT(ek / 100), 100), MOD(ek, 100)), DAY))
		dataType: int64
		formatString: 0
		lineageTag: f6e1c26c-c1d6-4814-9f8b-8a81088a3699

	column 'Delay Bucket' = SWITCH(TRUE(), ISBLANK('FactOrderDelivery'[IsOnTime]), BLANK(), 'FactOrderDelivery'[IsOnTime], "0. Đúng hạn", 'FactOrderDelivery'[DelayDays] <= 3, "1. Trễ 1-3 ngày", 'FactOrderDelivery'[DelayDays] <= 7, "2. Trễ 4-7 ngày", 'FactOrderDelivery'[DelayDays] <= 14, "3. Trễ 8-14 ngày", "4. Trễ trên 14 ngày")
		dataType: string
		lineageTag: cee3ebb0-1eff-40ad-a22f-f8aa6c22dbf3

	column OrderDeliveryKey
		dataType: int64
		formatString: 0
		lineageTag: a9689e2e-5fa0-40e3-8883-2167f74a8141
		summarizeBy: count
		sourceColumn: OrderDeliveryKey

		annotation SummarizationSetBy = Automatic

	column ItemCount
		dataType: int64
		formatString: 0
		lineageTag: 6666c82c-4081-4728-8d71-d68781508ab3
		summarizeBy: sum
		sourceColumn: ItemCount

		annotation SummarizationSetBy = Automatic

	column SellerCount
		dataType: int64
		formatString: 0
		lineageTag: ff6bfe24-0024-494d-a169-5b862f1b8afd
		summarizeBy: sum
		sourceColumn: SellerCount

		annotation SummarizationSetBy = Automatic

	column GMV
		dataType: double
		lineageTag: da030ef8-7c27-44ac-bc09-ed95f54d3b1a
		summarizeBy: sum
		sourceColumn: GMV

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

