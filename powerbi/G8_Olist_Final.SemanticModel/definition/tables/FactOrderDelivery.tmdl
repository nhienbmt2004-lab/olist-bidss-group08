	partition FactOrderDelivery = m
		mode: import
		source =
				let
					Source = MySQL.Database("127.0.0.1:3306", "olist_bi_group08", [Query="SELECT * FROM `FactOrderDelivery`", ReturnSingleDatabase=true]),
					Typed = Table.TransformColumnTypes(Source, {{"IsDelivered", type logical}, {"IsCancelled", type logical}, {"IsOnTime", type logical}})
				in
					Typed

	annotation PBI_ResultType = Table

