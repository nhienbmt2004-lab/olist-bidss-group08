	measure 'FC Next Month Orders' = VAR nxt = CALCULATE(MIN('ForecastMonthly'[MonthStart]), REMOVEFILTERS('ForecastMonthly'), 'ForecastMonthly'[Set] = "Future") RETURN CALCULATE([FC Orders Forecast], REMOVEFILTERS('ForecastMonthly'), 'ForecastMonthly'[MonthStart] = nxt)
		formatString: #,0
		displayFolder: 3.5 Forecast
		lineageTag: 608b257f-4513-4d6a-8937-b857f53aa952

	measure 'FC Next Month GMV' = VAR nxt = CALCULATE(MIN('ForecastMonthly'[MonthStart]), REMOVEFILTERS('ForecastMonthly'), 'ForecastMonthly'[Set] = "Future") RETURN CALCULATE([FC GMV Forecast], REMOVEFILTERS('ForecastMonthly'), 'ForecastMonthly'[MonthStart] = nxt)
		formatString: #,0
		displayFolder: 3.5 Forecast
		lineageTag: 25471625-4077-45a2-9d9f-4c1a17c4d15a

	measure 'FC MAPE Orders' = CALCULATE(MAX('ForecastMonthly'[MAPE_Backtest_pct]), REMOVEFILTERS('ForecastMonthly'), 'ForecastMonthly'[Metric] = "Orders") / 100
		formatString: 0.00%
		displayFolder: 3.5 Forecast
		lineageTag: 31c1729e-6fdb-487b-9855-8a8d3dcf9c61

	measure 'FC MAPE GMV' = CALCULATE(MAX('ForecastMonthly'[MAPE_Backtest_pct]), REMOVEFILTERS('ForecastMonthly'), 'ForecastMonthly'[Metric] = "GMV") / 100
		formatString: 0.00%
		displayFolder: 3.5 Forecast
		lineageTag: 17e2623b-af5c-4055-9f9f-302c6794125f

