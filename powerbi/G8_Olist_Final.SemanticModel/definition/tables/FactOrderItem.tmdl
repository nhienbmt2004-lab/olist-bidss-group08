table FactOrderItem
	lineageTag: 3245a1e1-f488-4742-8385-722fbd028289

	/// BIZ-02
	measure 'GMV at Risk' = CALCULATE([GMV], FILTER('FactOrderItem', 'FactOrderItem'[IsOnTime] == FALSE() || (NOT ISBLANK('FactOrderItem'[ReviewScore]) && 'FactOrderItem'[ReviewScore] <= 2)))
		formatString: #,0.00
		displayFolder: 3.5 Quy mô và rủi ro
		lineageTag: 9e5c1b15-b954-4371-9f47-d2f75b790504

	/// BQ4
	measure 'GMV YoY (T1-T8)' = VAR g18 = CALCULATE([GMV], REMOVEFILTERS('DimDate'), 'DimDate'[YearNumber] = 2018, 'DimDate'[MonthNumber] <= 8) VAR g17 = CALCULATE([GMV], REMOVEFILTERS('DimDate'), 'DimDate'[YearNumber] = 2017, 'DimDate'[MonthNumber] <= 8) RETURN DIVIDE(g18 - g17, g17)
		formatString: 0.0%
		displayFolder: 3.5 Quy mô và rủi ro
		lineageTag: 93a9add6-cb13-4e59-a5d2-0d752e521522

	/// Điều kiện chấm điểm >= 30
	measure 'Delivered Orders (Item)' = CALCULATE(DISTINCTCOUNT('FactOrderItem'[OrderId]), NOT ISBLANK('FactOrderItem'[IsOnTime]))
		formatString: #,0
		displayFolder: 3.5 SEL Người bán
		lineageTag: f0a764cf-af08-4310-8e29-8acbca86015c

	measure 'Late Orders (Item)' = CALCULATE(DISTINCTCOUNT('FactOrderItem'[OrderId]), 'FactOrderItem'[IsOnTime] == FALSE())
		formatString: #,0
		displayFolder: 3.5 SEL Người bán
		lineageTag: eaffa681-33e7-41c1-83ff-89fc978f9ee7

	measure 'OTD (Item)' = DIVIDE([Delivered Orders (Item)] - [Late Orders (Item)], [Delivered Orders (Item)])
		formatString: 0.00%
		displayFolder: 3.5 SEL Người bán
		lineageTag: 40c31095-94e3-4161-a5e7-e7cd27ca98b2

	measure 'Review (Item)' = AVERAGEX(FILTER(ADDCOLUMNS(VALUES('FactOrderItem'[OrderId]), "@r", CALCULATE(MAX('FactOrderItem'[ReviewScore]))), NOT ISBLANK([@r])), [@r])
		formatString: 0.00
		displayFolder: 3.5 SEL Người bán
		lineageTag: abc4ec14-aea4-49ad-943d-72e36e67adae

	/// SEL-01
	measure 'Handover On-time %' = DIVIDE(CALCULATE(COUNTROWS('FactOrderItem'), 'FactOrderItem'[HandoverOnTime] = 1), CALCULATE(COUNTROWS('FactOrderItem'), NOT ISBLANK('FactOrderItem'[HandoverOnTime])))
		formatString: 0.00%
		displayFolder: 3.5 SEL Người bán
		lineageTag: a67e3f5f-6282-452f-8bb6-9a87b765a1ad

	measure 'Avg Delay Days (Item)' = AVERAGEX(FILTER(ADDCOLUMNS(VALUES('FactOrderItem'[OrderId]), "@d", CALCULATE(MAX('FactOrderItem'[DelayDays]))), [@d] > 0), [@d])
		formatString: 0.0
		displayFolder: 3.5 SEL Người bán
		lineageTag: 466e01ed-d99a-48ca-8e8d-d0287751c351

	/// SEL-02 theo KPI Dictionary: chỉ trạng thái canceled
	measure 'Seller Cancellation Rate' = DIVIDE(CALCULATE(DISTINCTCOUNT('FactOrderItem'[OrderId]), 'FactOrderItem'[OrderStatus] = "canceled"), [Sales Orders])
		formatString: 0.00%
		displayFolder: 3.5 SEL Người bán
		lineageTag: 6936e91f-a57b-4bf9-bd8a-c4af09cca809

	/// L = 3,0; U = 4,5
	measure S_Review = VAR x = [Review (Item)] RETURN IF(NOT ISBLANK(x), 100 * MIN(1, MAX(0, (x - 3.0) / (4.5 - 3.0))))
		formatString: 0.0
		displayFolder: 3.5 Scorecard SEL-03
		lineageTag: 00bb9df4-de92-4f12-8516-77f31793d063

	/// L = 80%; U = 97%
	measure S_OTD = VAR x = [OTD (Item)] RETURN IF(NOT ISBLANK(x), 100 * MIN(1, MAX(0, (x - 0.80) / (0.97 - 0.80))))
		formatString: 0.0
		displayFolder: 3.5 Scorecard SEL-03
		lineageTag: c3d8bf51-f076-4ffa-8095-1b605c3f44b2

	/// L = 80%; U = 97%
	measure S_Handover = VAR x = [Handover On-time %] RETURN IF(NOT ISBLANK(x), 100 * MIN(1, MAX(0, (x - 0.80) / (0.97 - 0.80))))
		formatString: 0.0
		displayFolder: 3.5 Scorecard SEL-03
		lineageTag: ff7cf2ee-460e-474a-a07f-c1b0d69b6f21

	/// L = 14 ngày; U = 1 ngày
	measure S_Delay = VAR d = COALESCE([Avg Delay Days (Item)], 0) RETURN 100 * MIN(1, MAX(0, (14 - d) / (14 - 1)))
		formatString: 0.0
		displayFolder: 3.5 Scorecard SEL-03
		lineageTag: ea2ac7bb-42b8-43f5-bb52-103941b27d09

	/// L = 2%; U = 0%
	measure S_Cancel = VAR c = COALESCE([Seller Cancellation Rate], 0) RETURN 100 * MIN(1, MAX(0, (0.02 - c) / 0.02))
		formatString: 0.0
		displayFolder: 3.5 Scorecard SEL-03
		lineageTag: 483c0aea-b3de-447f-8b1c-a48736fe02ad

	measure 'SEL-03 Score' = IF(HASONEVALUE('DimSeller'[SellerId]) && [Delivered Orders (Item)] >= 30, 0.30 * [S_Review] + 0.25 * [S_OTD] + 0.25 * [S_Handover] + 0.10 * [S_Delay] + 0.10 * [S_Cancel])
		formatString: 0.0
		displayFolder: 3.5 Scorecard SEL-03
		lineageTag: 0c0a7439-912a-4ac9-b2d9-fbcf98ad83dc

	measure 'Seller Grade' = VAR s = [SEL-03 Score] RETURN IF(HASONEVALUE('DimSeller'[SellerId]), SWITCH(TRUE(), ISBLANK(s), "Chưa xếp hạng", s >= 85, "A", s >= 70, "B", s >= 50, "C", "D"))
		displayFolder: 3.5 Scorecard SEL-03
		lineageTag: eab9b0c0-255a-4818-be1c-7ec805c8a1c4

	measure 'Seller Action' = SWITCH([Seller Grade], "A", "Ưu tiên", "B", "Duy trì", "C", "Cảnh báo và hỗ trợ", "D", "Đề xuất hạn chế")
		displayFolder: 3.5 Scorecard SEL-03
		lineageTag: 525012d9-ee3a-4a78-b748-d554b30dd6e9

	measure 'Grade Color' = SWITCH([Seller Grade], "A", "#2E7D32", "B", "#1F6FB2", "C", "#E0A100", "D", "#C62828", "#9E9E9E")
		displayFolder: 3.5 Scorecard SEL-03
		lineageTag: d198ff4c-c315-4069-be98-8387d0775b69

	measure 'Sellers Eligible' = COUNTROWS(FILTER(VALUES('DimSeller'[SellerId]), [Delivered Orders (Item)] >= 30))
		formatString: #,0
		displayFolder: 3.5 Scorecard SEL-03
		lineageTag: 778261bb-e237-4755-948f-1838d6390be8

	measure 'Avg SEL-03' = AVERAGEX(FILTER(VALUES('DimSeller'[SellerId]), [Delivered Orders (Item)] >= 30), [SEL-03 Score])
		formatString: 0.0
		displayFolder: 3.5 Scorecard SEL-03
		lineageTag: 1f87444f-d95a-494e-bac7-156dabcc8d1d

	measure 'Sellers by Grade' = VAR g = SELECTEDVALUE('GradeBand'[Grade]) RETURN COUNTROWS(FILTER(VALUES('DimSeller'[SellerId]), [Seller Grade] = g))
		formatString: #,0
		displayFolder: 3.5 Scorecard SEL-03
		lineageTag: 6ebbd41d-d6d7-47db-8a0d-b6d5ce5ac541

	measure 'GMV by Grade' = VAR g = SELECTEDVALUE('GradeBand'[Grade]) RETURN SUMX(FILTER(VALUES('DimSeller'[SellerId]), [Seller Grade] = g), [GMV])
		formatString: #,0
		displayFolder: 3.5 Scorecard SEL-03
		lineageTag: 19b7685d-8779-429c-88c1-9e4f6e33a6cb

	measure 'Share Grade C-D' = DIVIDE(COUNTROWS(FILTER(VALUES('DimSeller'[SellerId]), [Seller Grade] IN {"C", "D"})), [Sellers Eligible])
		formatString: 0.0%
		displayFolder: 3.5 Scorecard SEL-03
		lineageTag: 44898f1d-613a-4a4f-a272-7921ad72d005

	measure 'GMV at Risk C-D' = SUMX(FILTER(VALUES('DimSeller'[SellerId]), [Seller Grade] IN {"C", "D"}), [GMV at Risk])
		formatString: #,0
		displayFolder: 3.5 Scorecard SEL-03
		lineageTag: e072eb9c-c435-4215-b454-0628eaf9d942

	measure 'Seller Alert' = IF([Delivered Orders (Item)] >= 30 && ([Seller Grade] IN {"C", "D"} || [Handover On-time %] < 0.90), 1, 0)
		formatString: 0
		displayFolder: 3.5 Alert
		lineageTag: 11ba9204-c924-4d0b-b50f-42125e42d829

	measure GMV = SUM('FactOrderItem'[Price])
		formatString: #,0.00
		lineageTag: e89a2c95-cc82-4d94-9c16-97e340a12727

	measure Freight = SUM('FactOrderItem'[FreightValue])
		formatString: #,0.00
		lineageTag: 031a6f35-6cc9-4ada-9120-b64d6e1751d8

	measure 'Order Items' = COUNTROWS('FactOrderItem')
		formatString: #,0
		lineageTag: 92db0d14-b219-4f1d-8bdb-a7cdf4c228e8

	measure 'Sales Orders' = DISTINCTCOUNT('FactOrderItem'[OrderId])
		formatString: #,0
