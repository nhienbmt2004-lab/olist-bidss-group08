	/// Used by Seller Performance scatter/card/table. DimSeller filters FactOrderItem.
	measure Seller_Late_Rate = DIVIDE(COALESCE([Late Orders (Item)], 0), [Delivered Orders (Item)])
		formatString: 0.00%
		lineageTag: 96f02071-45ae-4b71-90f2-9532f3b8a95c

	/// Used by Product/Category table and Seller Performance card/table.
	/// Review (Item) deduplicates OrderId inside the current seller/category filter.
	measure Avg_Seller_Review = [Review (Item)]
		formatString: 0.00
		lineageTag: f9794439-4d97-45fe-ba2a-75f4b0425624

	measure Total_Products_Sold = COUNT(FactOrderItem[OrderId])
		formatString: 0
		lineageTag: 53ec7c79-18e6-4808-8793-61c3b33b54bc

	measure Category_Revenue_Share_% =
			
			DIVIDE(
			    SUM(FactOrderItem[price]),
			    CALCULATE(SUM(FactOrderItem[price]), ALL(DimCategory)),
			    0
			)
		lineageTag: 11bb5cb0-e011-4ab0-8c68-bd8265b781e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avg_Category_Discount_% =
			
			AVERAGEX(
			    FactOrderItem,
			    DIVIDE(FactOrderItem[Price] - FactOrderItem[Price], FactOrderItem[Price], 0)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0c06636f-1298-4f8d-acc9-fc750a9067ee

	measure Avg_Unit_Price = AVERAGE(FactOrderItem[Price])
		lineageTag: 12d9e97d-bba6-4a07-8413-1f3f4bf1f8d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Seller Score 4.2' =
			VAR Ready = [Seller Score Data Status 4.2] = "Đủ dữ liệu"
			RETURN IF(Ready, ROUND(0.30 * [S_Review] + 0.25 * [S_OTD] + 0.25 * [S_Handover] + 0.10 * [S_Delay] + 0.10 * [S_Cancel], 4))
		formatString: 0.0
		displayFolder: DSS Seller Scoring
		lineageTag: 8bb36b18-906f-4f18-90e9-9daf1345a3a2

	measure 'Seller Rank 4.2' =
			VAR CurrentScore = [Seller Score 4.2]
			VAR Candidates =
				FILTER(
					ADDCOLUMNS(
						ALLSELECTED('DimSeller'[SellerId]),
						"@SellerScore", CALCULATE([Seller Score 4.2])
					),
					NOT ISBLANK('DimSeller'[SellerId])
						&& NOT ISBLANK([@SellerScore])
				)
			RETURN
				IF(
					ISINSCOPE('DimSeller'[SellerId])
						&& HASONEVALUE('DimSeller'[SellerId])
						&& NOT ISBLANK(CurrentScore),
					RANKX(Candidates, [@SellerScore], CurrentScore, DESC, DENSE),
					BLANK()
				)
		formatString: 0
		displayFolder: DSS Seller Ranking
		lineageTag: e6fd3327-1175-46ae-905f-f4bafcb09cd1

	measure 'Seller Grade 4.2' =
			VAR ScoreValue = [Seller Score 4.2]
			RETURN
				IF(
					HASONEVALUE('DimSeller'[SellerId])
						&& NOT ISBLANK(SELECTEDVALUE('DimSeller'[SellerId])),
					SWITCH(
						TRUE(),
						ISBLANK(ScoreValue), "Chưa đủ dữ liệu",
						ScoreValue >= 85, "A",
						ScoreValue >= 70, "B",
						ScoreValue >= 50, "C",
						"D"
					),
					BLANK()
				)
		displayFolder: DSS Seller Ranking
		lineageTag: 1521abac-c062-4a04-ab3c-d756d2c2f54e

	measure 'Seller Action 4.2' =
			SWITCH(
				[Seller Grade 4.2],
				"A", "Ưu tiên",
				"B", "Duy trì",
				"C", "Cảnh báo và hỗ trợ",
				"D", "Đề xuất hạn chế",
				"Chưa đủ dữ liệu", "Kiểm tra dữ liệu",
				BLANK()
			)
		displayFolder: DSS Seller Ranking
		lineageTag: f5f3ef2d-c4ca-456e-a0ef-78f955f07fa8

	/// Seller-context KPI; denominator is distinct orders with known IsOnTime, not all sales orders.
	measure 'Seller Late Rate 4.2' =
			VAR DeliveredOrders =
				CALCULATE(
					DISTINCTCOUNT('FactOrderItem'[OrderId]),
					KEEPFILTERS(NOT ISBLANK('FactOrderItem'[IsOnTime]))
				)
			VAR LateOrders =
				CALCULATE(
					DISTINCTCOUNT('FactOrderItem'[OrderId]),
					KEEPFILTERS('FactOrderItem'[IsOnTime] == FALSE())
				)
			RETURN
				DIVIDE(COALESCE(LateOrders, 0), DeliveredOrders)
		formatString: 0.00%
		displayFolder: DSS Threshold Alert
		lineageTag: a0c2203b-b00d-4a09-9902-b369fc83b831

	/// Reuses order-deduplicated review from FactOrderItem; not Avg_Seller_Review from FactReview.
	measure 'Seller Review Score 4.2' = [Review (Item)]
		formatString: 0.00
		displayFolder: DSS Threshold Alert
		lineageTag: d934ad5a-46ae-40f2-8978-3823d1523556

	/// Canceled only, consistent with SEL-02. Orders without seller items cannot be attributed.
	measure 'Seller Cancellation Rate 4.2' =
			VAR SalesOrders = [Sales Orders]
			VAR MissingStatusRows =
				COUNTROWS(
					FILTER(
						'FactOrderItem',
						ISBLANK('FactOrderItem'[OrderStatus])
							|| 'FactOrderItem'[OrderStatus] = ""
					)
				)
			VAR CancelledOrders =
				CALCULATE(
					DISTINCTCOUNT('FactOrderItem'[OrderId]),
					KEEPFILTERS('FactOrderItem'[OrderStatus] = "canceled")
				)
			RETURN
				IF(
					SalesOrders > 0 && COALESCE(MissingStatusRows, 0) = 0,
					DIVIDE(COALESCE(CancelledOrders, 0), SalesOrders),
					BLANK()
				)
		formatString: 0.00%
		displayFolder: DSS Threshold Alert
		lineageTag: 7777540d-1750-4385-8363-1047c391bf7b

	/// Alert policy: >=30 OTD-known orders (Seller eligibility reused), >=1 reviewed order.
	/// No new minimum review coverage is assumed. Missing data takes precedence over traffic-light levels.
	measure 'Seller Alert Data Status 4.2' =
			VAR SingleSeller =
				HASONEVALUE('DimSeller'[SellerId])
					&& NOT ISBLANK(SELECTEDVALUE('DimSeller'[SellerId]))
			VAR SalesOrders = [Sales Orders]
			VAR DeliveredOrders =
				CALCULATE(
					DISTINCTCOUNT('FactOrderItem'[OrderId]),
					KEEPFILTERS(NOT ISBLANK('FactOrderItem'[IsOnTime]))
				)
			VAR ReviewedOrders =
				CALCULATE(
					DISTINCTCOUNT('FactOrderItem'[OrderId]),
					KEEPFILTERS(NOT ISBLANK('FactOrderItem'[ReviewScore]))
				)
			VAR InvalidReviewRows =
				COUNTROWS(
					FILTER(
						'FactOrderItem',
						NOT ISBLANK('FactOrderItem'[ReviewScore])
							&& ('FactOrderItem'[ReviewScore] < 1 || 'FactOrderItem'[ReviewScore] > 5)
					)
				)
			VAR LateValue = [Seller Late Rate 4.2]
			VAR ReviewValue = [Seller Review Score 4.2]
			VAR CancelValue = [Seller Cancellation Rate 4.2]
			VAR MissingReasons =
				IF(COALESCE(SalesOrders, 0) = 0, "Không có đơn có item; ", "")
					& IF(COALESCE(DeliveredOrders, 0) < 30, "Dưới 30 đơn đủ thông tin OTD; ", "")
					& IF(COALESCE(ReviewedOrders, 0) = 0, "Không có review; ", "")
					& IF(COALESCE(InvalidReviewRows, 0) > 0, "Review ngoài khoảng 1-5; ", "")
					& IF(ISBLANK(LateValue) || LateValue < 0 || LateValue > 1, "Late Rate thiếu hoặc không hợp lệ; ", "")
					& IF(ISBLANK(ReviewValue), "Review Score thiếu; ", "")
					& IF(ISBLANK(CancelValue) || CancelValue < 0 || CancelValue > 1, "Cancellation Rate thiếu hoặc không hợp lệ (kiểm tra OrderStatus); ", "")
			RETURN
				IF(
					SingleSeller,
					IF(MissingReasons = "", "Đủ dữ liệu", LEFT(MissingReasons, LEN(MissingReasons) - 2)),
					BLANK()
				)
		displayFolder: DSS Threshold Alert
		lineageTag: 5b2007f7-c9a8-4797-b544-56ba1fa19e0a

	/// Threshold policy requiring group confirmation; not an industry standard.
	/// Late: Green <=10%, Yellow >10% and <20%, Red >=20% (Late Target / heatmap anchors).
	/// Review: Green >=4, Yellow >=3 and <4, Red <3 (3 from S_Review; 4 is provisional).
	/// Cancel: Green <1%, Yellow >=1% and <2%, Red >=2% (2% from S_Cancel; 1% is provisional).
	measure 'Seller Alert Level 4.2' =
			VAR DataStatus = [Seller Alert Data Status 4.2]
			VAR LateValue = [Seller Late Rate 4.2]
			VAR ReviewValue = [Seller Review Score 4.2]
			VAR CancelValue = [Seller Cancellation Rate 4.2]
			RETURN
				IF(
					NOT ISBLANK(DataStatus),
					SWITCH(
						TRUE(),
						DataStatus <> "Đủ dữ liệu", "Chưa đủ dữ liệu",
						LateValue >= 0.20 || ReviewValue < 3.0 || CancelValue >= 0.02, "Red",
						LateValue > 0.10 || ReviewValue < 4.0 || CancelValue >= 0.01, "Yellow",
						"Green"
					),
					BLANK()
				)
		displayFolder: DSS Threshold Alert
		lineageTag: 62e5439b-3e51-441e-ae63-215a824c8a3e

	/// Lists every breached KPI, not only the KPI determining the worst level.
	measure 'Seller Alert Reason 4.2' =
			VAR AlertLevel = [Seller Alert Level 4.2]
			VAR LateValue = [Seller Late Rate 4.2]
			VAR ReviewValue = [Seller Review Score 4.2]
			VAR CancelValue = [Seller Cancellation Rate 4.2]
			VAR Breaches =
				IF(
					LateValue > 0.10,
					"Late Rate " & FORMAT(LateValue, "0.00%") & IF(LateValue >= 0.20, " >= 20% (Red); ", " > 10% (Yellow); "),
					""
				)
					& IF(
						ReviewValue < 4.0,
						"Review " & FORMAT(ReviewValue, "0.00") & IF(ReviewValue < 3.0, " < 3 (Red); ", " < 4 (Yellow); "),
						""
					)
					& IF(
						CancelValue >= 0.01,
						"Cancellation " & FORMAT(CancelValue, "0.00%") & IF(CancelValue >= 0.02, " >= 2% (Red); ", " >= 1% (Yellow); "),
						""
					)
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(AlertLevel), BLANK(),
					AlertLevel = "Chưa đủ dữ liệu", [Seller Alert Data Status 4.2],
					AlertLevel = "Green", "Trong ngưỡng: Late <= 10%; Review >= 4; Cancellation < 1%",
					LEFT(Breaches, MAX(0, LEN(Breaches) - 2))
				)
		displayFolder: DSS Threshold Alert
		lineageTag: f68e6f85-31e0-4f64-a014-d89d1a5867a0

	measure 'Sellers Red 4.2' =
			COALESCE(
				COUNTROWS(
					FILTER(
						VALUES('DimSeller'[SellerId]),
						NOT ISBLANK('DimSeller'[SellerId])
							&& [Seller Alert Level 4.2] = "Red"
