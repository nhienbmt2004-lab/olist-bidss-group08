	measure 'Seller Score Data Status 4.2' =
			VAR SingleSeller = HASONEVALUE('DimSeller'[SellerId]) && NOT ISBLANK(SELECTEDVALUE('DimSeller'[SellerId]))
			VAR SalesOrders = [Sales Orders]
			VAR DeliveredOrders = [Delivered Orders (Item)]
			VAR ReviewValue = [Seller Review Score 4.2]
			VAR HandoverValue = [Handover On-time %]
			VAR InvalidReviewRows = COUNTROWS(FILTER('FactOrderItem', NOT ISBLANK('FactOrderItem'[ReviewScore]) && ('FactOrderItem'[ReviewScore] < 1 || 'FactOrderItem'[ReviewScore] > 5)))
			VAR InvalidHandoverRows = COUNTROWS(FILTER('FactOrderItem', NOT ISBLANK('FactOrderItem'[HandoverOnTime]) && NOT ('FactOrderItem'[HandoverOnTime] IN {0, 1})))
			VAR InvalidDelayRows = COUNTROWS(FILTER('FactOrderItem', NOT ISBLANK('FactOrderItem'[IsOnTime]) && (ISBLANK('FactOrderItem'[DelayDays]) || 'FactOrderItem'[DelayDays] < 0 || ('FactOrderItem'[IsOnTime] == FALSE() && 'FactOrderItem'[DelayDays] <= 0) || ('FactOrderItem'[IsOnTime] == TRUE() && 'FactOrderItem'[DelayDays] > 0))))
			VAR Reasons =
			    IF(COALESCE(SalesOrders, 0) = 0, "Không có đơn có item; ", "")
			    & IF(COALESCE(DeliveredOrders, 0) < 30, "Dưới 30 đơn đủ thông tin OTD; ", "")
			    & IF(ISBLANK(ReviewValue), "Thiếu đánh giá; ", "")
			    & IF(COALESCE(InvalidReviewRows, 0) > 0, "Review ngoài khoảng 1-5; ", "")
			    & IF(ISBLANK(HandoverValue), "Thiếu dữ liệu bàn giao; ", "")
			    & IF(COALESCE(InvalidHandoverRows, 0) > 0, "Bàn giao ngoài mã 0/1; ", "")
			    & IF(COALESCE(InvalidDelayRows, 0) > 0, "DelayDays thiếu hoặc mâu thuẫn OTD; ", "")
			    & IF(ISBLANK([Seller Cancellation Rate 4.2]), "Thiếu trạng thái đơn; ", "")
			RETURN IF(SingleSeller, IF(Reasons = "", "Đủ dữ liệu", LEFT(Reasons, LEN(Reasons) - 2)))
		displayFolder: DSS Report Support
		lineageTag: 10813877-503e-4bdc-b330-6cd8b839afd6

	/// Dedicated to section 4.2; no model, ETL or shared KPI changes.
	measure 'Seller Reviewed Orders 4.2' = CALCULATE(DISTINCTCOUNT('FactOrderItem'[OrderId]), KEEPFILTERS(NOT ISBLANK('FactOrderItem'[ReviewScore])))
		formatString: #,0
		displayFolder: DSS Report Support
		lineageTag: 5be58705-c71b-480a-b2d2-d9677dac03d7

	/// Dedicated to section 4.2; no model, ETL or shared KPI changes.
	measure 'Seller Handover Coverage 4.2' = DIVIDE(CALCULATE(COUNTROWS('FactOrderItem'), KEEPFILTERS(NOT ISBLANK('FactOrderItem'[HandoverOnTime]))), COUNTROWS('FactOrderItem'))
		formatString: 0.0%
		displayFolder: DSS Report Support
		lineageTag: 12b96d90-566c-4bc5-aecc-c488d9ab4637

	measure 'Seller Action Group 4.2' =
			VAR SingleSeller = HASONEVALUE('DimSeller'[SellerId]) && NOT ISBLANK(SELECTEDVALUE('DimSeller'[SellerId]))
			VAR ScoreValue = [Seller Score 4.2]
			VAR GradeValue = [Seller Grade 4.2]
			VAR AlertValue = [Seller Alert Level 4.2]
			RETURN
				IF(
					SingleSeller,
					SWITCH(
						TRUE(),
						ISBLANK(ScoreValue), "Not Scored",
						AlertValue = "Red" || GradeValue = "D", "Investigate",
						AlertValue = "Yellow" || GradeValue = "C", "Warning",
						GradeValue = "B" && AlertValue = "Green", "Support",
						GradeValue = "A" && AlertValue = "Green", "Maintain",
						BLANK()
					),
					BLANK()
				)
		displayFolder: DSS Seller Ranking
		lineageTag: cb84a09b-4dd4-4e4d-bac7-0919a2fb4a4d

	measure 'BQ4 GMV 2017 Jan-Aug' = CALCULATE([GMV], REMOVEFILTERS('DimDate'), 'DimDate'[YearNumber] = 2017, 'DimDate'[MonthNumber] >= 1, 'DimDate'[MonthNumber] <= 8)
