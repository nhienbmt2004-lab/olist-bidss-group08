					COUNTROWS(
						FILTER(
							VALUES('DimSeller'[SellerId]),
							NOT ISBLANK('DimSeller'[SellerId])
								&& [Seller Alert Data Status 4.2] = "Đủ dữ liệu"
						)
					),
