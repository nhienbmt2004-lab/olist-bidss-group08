	column Region =
			
			SWITCH (
			    TRUE (),
			    CustomerGeography[StateCode] IN { "AC", "AP", "AM", "PA", "RO", "RR", "TO" }, "Norte",
			    CustomerGeography[StateCode] IN { "AL", "BA", "CE", "MA", "PB", "PE", "PI", "RN", "SE" }, "Nordeste",
			    CustomerGeography[StateCode] IN { "DF", "GO", "MT", "MS" }, "Centro-Oeste",
			    CustomerGeography[StateCode] IN { "ES", "MG", "RJ", "SP" }, "Sudeste",
			    CustomerGeography[StateCode] IN { "PR", "RS", "SC" }, "Sul"
			)
		lineageTag: 6f8934f3-9a15-4c2e-87db-48331069feb2
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	hierarchy Location
		lineageTag: ecce70b8-3035-43a0-a122-0bf33d89ca32

