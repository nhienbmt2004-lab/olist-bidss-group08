	partition CustomerGeography = m
		mode: import
		source =
				let
					Source = MySQL.Database("127.0.0.1:3306", "olist_bi_group08", [Query="SELECT * FROM `DimGeography`", ReturnSingleDatabase=true])
				in
					Source

