-- Run in Power BI Desktop DAX query view after applying
-- Olist_BQ4_Growth_Measures.tmdl to G8_Olist_BQ_Aligned.pbix.
EVALUATE
ROW(
    "BQ4 overall growth Jan-Aug", [BQ4 GMV Growth %],
    "BQ4 overall review Jan-Aug 2018", [BQ4 Review 2018 Jan-Aug],
    "BQ5 next month orders", [FC Next Month Orders],
    "BQ5 next month GMV", [FC Next Month GMV]
)

EVALUATE
TOPN(
    20,
    ADDCOLUMNS(
        VALUES('DimCategory'[CategoryName]),
        "GMV2017", [BQ4 GMV 2017 Jan-Aug],
        "GMV2018", [BQ4 GMV 2018 Jan-Aug],
        "Growth", [BQ4 GMV Growth %],
        "Review2018", [BQ4 Review 2018 Jan-Aug]
    ),
    [GMV2018], DESC
)
