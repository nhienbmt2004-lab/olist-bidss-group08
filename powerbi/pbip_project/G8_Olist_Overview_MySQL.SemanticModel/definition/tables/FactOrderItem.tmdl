	measure 'Freight Ratio' = DIVIDE([Freight], [GMV])
		formatString: 0.00%
		lineageTag: 8d451d70-c106-4219-b962-45e49a0f25cd

	measure 'GMV at Risk %' = DIVIDE ( [GMV at Risk], [GMV] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 29cf1e34-83c9-47b5-a0b4-86e4a3ec52d1

	measure 'Sellers Alerted' = COUNTROWS(FILTER(VALUES('DimSeller'[SellerId]), [Seller Alert] = 1))
		formatString: #,0
		displayFolder: 4.0 Dashboard v2
		lineageTag: 0d6f30cf-cf95-4f99-b0e2-666fe29775cb

	measure 'Late Handover Share' = DIVIDE(CALCULATE(DISTINCTCOUNT('FactOrderItem'[OrderId]), 'FactOrderItem'[IsOnTime] == FALSE(), 'FactOrderItem'[HandoverOnTime] = 0), [Late Orders (Item)])
		formatString: 0.0%
		displayFolder: 4.0 Dashboard v2
		lineageTag: 432a35a9-096a-4b57-bc57-4b81dcedf95d

	measure 'Late Cause' = VAR s = [Late Handover Share] RETURN IF(ISBLANK(s), BLANK(), IF(s >= 0.5, "Người bán", "Vận chuyển"))
		displayFolder: 4.0 Dashboard v2
		lineageTag: 3393ad36-8005-4c66-aa37-8af5e27dcc4d

	measure 'Sub GMV' = VAR n = [Sales Orders] RETURN IF(ISBLANK(n), BLANK(), FORMAT(n, "#,0", "vi-VN") & " đơn | YoY " & FORMAT([GMV YoY (T1-T8)], "+0.0%;-0.0%", "vi-VN"))
		displayFolder: 4.0 Dashboard v2
		lineageTag: eba7482b-ef08-4486-bb57-24bc206310d1

	measure 'Sub Risk' = VAR x = DIVIDE([GMV at Risk], [GMV]) RETURN IF(ISBLANK(x), BLANK(), FORMAT(x, "0.0%", "vi-VN") & " tổng GMV")
		displayFolder: 4.0 Dashboard v2
		lineageTag: f3c31fdb-bbf6-44d9-8bea-e0eccaf9f1e6

	measure 'Sub Seller' = VAR n = [Sellers Alerted] RETURN IF(ISBLANK(n), BLANK(), FORMAT(n, "#,0", "vi-VN") & " người bán cần xử lý")
		displayFolder: 4.0 Dashboard v2
		lineageTag: 208733dc-ca14-46a1-8dd1-890c6f946ccd

	measure 'Sub Handover' = VAR s = [Late Handover Share] RETURN IF(ISBLANK(s), BLANK(), FORMAT(s, "0.0%", "vi-VN") & " đơn trễ do bàn giao")
		displayFolder: 4.0 Dashboard v2
		lineageTag: b864b7a1-fc9e-41fe-8c22-fabdacfc0ecd

	measure Total_Sellers_1 = DISTINCTCOUNT(DimSeller[SellerId])
		formatString: 0
		lineageTag: c4312129-5afa-4b01-84e9-1b6ad21c98c8

	measure Avg_GMV_Per_Seller = DIVIDE(SUM(FactOrderItem[price]), [Total_Sellers_1], 0)
		lineageTag: 9f996344-e805-4272-9ce7-99b5c6f89855

