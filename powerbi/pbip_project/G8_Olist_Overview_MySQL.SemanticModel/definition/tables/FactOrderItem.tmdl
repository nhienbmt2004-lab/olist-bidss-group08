	/// Used by Seller Performance scatter/card/table. DimSeller filters FactOrderItem.
	measure Seller_Late_Rate = DIVIDE(COALESCE([Late Orders (Item)], 0), [Delivered Orders (Item)])
		formatString: 0.00%
		lineageTag: 96f02071-45ae-4b71-90f2-9532f3b8a95c

	/// Used by Product/Category table and Seller Performance card/table.
	/// Review (Item) deduplicates OrderId inside the current seller/category filter.
	measure Avg_Seller_Review = [Review (Item)]
		formatString: 0.00
		lineageTag: f9794439-4d97-45fe-ba2a-75f4b0425624

	measure Total_Products_Sold = COUNT(FactOrderItem[OrderId])
		formatString: 0
		lineageTag: 53ec7c79-18e6-4808-8793-61c3b33b54bc

	measure Category_Revenue_Share_% =
			
			DIVIDE(
			    SUM(FactOrderItem[price]),
			    CALCULATE(SUM(FactOrderItem[price]), ALL(DimCategory)),
			    0
			)
		lineageTag: 11bb5cb0-e011-4ab0-8c68-bd8265b781e3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Avg_Category_Discount_% =
			
			AVERAGEX(
			    FactOrderItem,
			    DIVIDE(FactOrderItem[Price] - FactOrderItem[Price], FactOrderItem[Price], 0)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0c06636f-1298-4f8d-acc9-fc750a9067ee

	measure Avg_Unit_Price = AVERAGE(FactOrderItem[Price])
		lineageTag: 12d9e97d-bba6-4a07-8413-1f3f4bf1f8d5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Seller Score 4.2' =
			VAR Ready = [Seller Score Data Status 4.2] = "Đủ dữ liệu"
			VAR ReviewValue = [Seller Review Score 4.2]
			VAR OTDValue = [OTD (Item)]
			VAR HandoverValue = [Handover On-time %]
			VAR LateOrders = COALESCE([Late Orders (Item)], 0)
			VAR DelayValue = IF(LateOrders = 0, 0, [Avg Delay Days (Item)])
			VAR CancelValue = [Seller Cancellation Rate 4.2]
			VAR ReviewScore = 100 * MIN(1, MAX(0, (ReviewValue - 3.0) / 1.5))
			VAR OTDScore = 100 * MIN(1, MAX(0, (OTDValue - 0.80) / 0.17))
			VAR HandoverScore = 100 * MIN(1, MAX(0, (HandoverValue - 0.80) / 0.17))
			VAR DelayScore = 100 * MIN(1, MAX(0, (14 - DelayValue) / 13))
			VAR CancelScore = 100 * MIN(1, MAX(0, (0.02 - CancelValue) / 0.02))
			RETURN IF(Ready, ROUND(0.30 * ReviewScore + 0.25 * OTDScore + 0.25 * HandoverScore + 0.10 * DelayScore + 0.10 * CancelScore, 4))
		formatString: 0.0
		displayFolder: DSS Seller Scoring
		lineageTag: 8bb36b18-906f-4f18-90e9-9daf1345a3a2

	measure 'Seller Rank 4.2' =
			VAR CurrentScore = [Seller Score 4.2]
			VAR Candidates =
				FILTER(
					ADDCOLUMNS(
						ALLSELECTED('DimSeller'[SellerId]),
						"@SellerScore", CALCULATE([Seller Score 4.2])
					),
					NOT ISBLANK('DimSeller'[SellerId])
						&& NOT ISBLANK([@SellerScore])
				)
			RETURN
				IF(
					ISINSCOPE('DimSeller'[SellerId])
						&& HASONEVALUE('DimSeller'[SellerId])
						&& NOT ISBLANK(CurrentScore),
					RANKX(Candidates, [@SellerScore], CurrentScore, DESC, DENSE),
					BLANK()
				)
		formatString: 0
		displayFolder: DSS Seller Ranking
		lineageTag: e6fd3327-1175-46ae-905f-f4bafcb09cd1

	measure 'Seller Grade 4.2' =
			VAR ScoreValue = [Seller Score 4.2]
			RETURN
				IF(
					HASONEVALUE('DimSeller'[SellerId])
						&& NOT ISBLANK(SELECTEDVALUE('DimSeller'[SellerId])),
					SWITCH(
						TRUE(),
						ISBLANK(ScoreValue), "Chưa đủ dữ liệu",
						ScoreValue >= 85, "A",
						ScoreValue >= 70, "B",
						ScoreValue >= 50, "C",
						"D"
					),
					BLANK()
				)
		displayFolder: DSS Seller Ranking
		lineageTag: 1521abac-c062-4a04-ab3c-d756d2c2f54e

	measure 'Seller Action 4.2' =
			SWITCH(
				[Seller Grade 4.2],
				"A", "Ưu tiên",
				"B", "Duy trì",
				"C", "Cảnh báo và hỗ trợ",
				"D", "Đề xuất hạn chế",
				"Chưa đủ dữ liệu", "Kiểm tra dữ liệu",
				BLANK()
			)
		displayFolder: DSS Seller Ranking
		lineageTag: f5f3ef2d-c4ca-456e-a0ef-78f955f07fa8

	/// Seller-context KPI; denominator is distinct orders with known IsOnTime, not all sales orders.
	measure 'Seller Late Rate 4.2' =
			VAR DeliveredOrders =
				CALCULATE(
					DISTINCTCOUNT('FactOrderItem'[OrderId]),
					KEEPFILTERS(NOT ISBLANK('FactOrderItem'[IsOnTime]))
				)
			VAR LateOrders =
				CALCULATE(
					DISTINCTCOUNT('FactOrderItem'[OrderId]),
					KEEPFILTERS('FactOrderItem'[IsOnTime] == FALSE())
				)
			RETURN
				DIVIDE(COALESCE(LateOrders, 0), DeliveredOrders)
		formatString: 0.00%
		displayFolder: DSS Threshold Alert
		lineageTag: a0c2203b-b00d-4a09-9902-b369fc83b831

	/// Reuses order-deduplicated review from FactOrderItem; not Avg_Seller_Review from FactReview.
	measure 'Seller Review Score 4.2' = [Review (Item)]
		formatString: 0.00
		displayFolder: DSS Threshold Alert
		lineageTag: d934ad5a-46ae-40f2-8978-3823d1523556

	/// Canceled only, consistent with SEL-02. Orders without seller items cannot be attributed.
	measure 'Seller Cancellation Rate 4.2' =
			VAR SalesOrders = [Sales Orders]
			VAR MissingStatusRows =
				COUNTROWS(
					FILTER(
						'FactOrderItem',
						ISBLANK('FactOrderItem'[OrderStatus])
							|| 'FactOrderItem'[OrderStatus] = ""
					)
				)
			VAR CancelledOrders =
				CALCULATE(
					DISTINCTCOUNT('FactOrderItem'[OrderId]),
					KEEPFILTERS('FactOrderItem'[OrderStatus] = "canceled")
				)
			RETURN
				IF(
					SalesOrders > 0 && COALESCE(MissingStatusRows, 0) = 0,
					DIVIDE(COALESCE(CancelledOrders, 0), SalesOrders),
					BLANK()
				)
		formatString: 0.00%
		displayFolder: DSS Threshold Alert
		lineageTag: 7777540d-1750-4385-8363-1047c391bf7b

	/// Alert policy: >=30 OTD-known orders (Seller eligibility reused), >=1 reviewed order.
	/// No new minimum review coverage is assumed. Missing data takes precedence over traffic-light levels.
	measure 'Seller Alert Data Status 4.2' =
			VAR SingleSeller =
				HASONEVALUE('DimSeller'[SellerId])
					&& NOT ISBLANK(SELECTEDVALUE('DimSeller'[SellerId]))
			VAR SalesOrders = [Sales Orders]
			VAR DeliveredOrders =
				CALCULATE(
					DISTINCTCOUNT('FactOrderItem'[OrderId]),
					KEEPFILTERS(NOT ISBLANK('FactOrderItem'[IsOnTime]))
				)
			VAR ReviewedOrders =
				CALCULATE(
					DISTINCTCOUNT('FactOrderItem'[OrderId]),
					KEEPFILTERS(NOT ISBLANK('FactOrderItem'[ReviewScore]))
				)
			VAR InvalidReviewRows =
				COUNTROWS(
					FILTER(
						'FactOrderItem',
						NOT ISBLANK('FactOrderItem'[ReviewScore])
							&& ('FactOrderItem'[ReviewScore] < 1 || 'FactOrderItem'[ReviewScore] > 5)
					)
				)
			VAR LateValue = [Seller Late Rate 4.2]
			VAR ReviewValue = [Seller Review Score 4.2]
			VAR CancelValue = [Seller Cancellation Rate 4.2]
			VAR MissingReasons =
				IF(COALESCE(SalesOrders, 0) = 0, "Không có đơn có item; ", "")
					& IF(COALESCE(DeliveredOrders, 0) < 30, "Dưới 30 đơn đủ thông tin OTD; ", "")
					& IF(COALESCE(ReviewedOrders, 0) = 0, "Không có review; ", "")
					& IF(COALESCE(InvalidReviewRows, 0) > 0, "Review ngoài khoảng 1-5; ", "")
					& IF(ISBLANK(LateValue) || LateValue < 0 || LateValue > 1, "Late Rate thiếu hoặc không hợp lệ; ", "")
					& IF(ISBLANK(ReviewValue), "Review Score thiếu; ", "")
					& IF(ISBLANK(CancelValue) || CancelValue < 0 || CancelValue > 1, "Cancellation Rate thiếu hoặc không hợp lệ (kiểm tra OrderStatus); ", "")
			RETURN
				IF(
					SingleSeller,
					IF(MissingReasons = "", "Đủ dữ liệu", LEFT(MissingReasons, LEN(MissingReasons) - 2)),
					BLANK()
				)
		displayFolder: DSS Threshold Alert
		lineageTag: 5b2007f7-c9a8-4797-b544-56ba1fa19e0a

	/// Threshold policy requiring group confirmation; not an industry standard.
	/// Late: Green <=10%, Yellow >10% and <20%, Red >=20% (Late Target / heatmap anchors).
	/// Review: Green >=4, Yellow >=3 and <4, Red <3 (3 from S_Review; 4 is provisional).
	/// Cancel: Green <1%, Yellow >=1% and <2%, Red >=2% (2% from S_Cancel; 1% is provisional).
	measure 'Seller Alert Level 4.2' =
			VAR DataStatus = [Seller Alert Data Status 4.2]
			VAR LateValue = [Seller Late Rate 4.2]
			VAR ReviewValue = [Seller Review Score 4.2]
			VAR CancelValue = [Seller Cancellation Rate 4.2]
			RETURN
				IF(
					NOT ISBLANK(DataStatus),
					SWITCH(
						TRUE(),
						DataStatus <> "Đủ dữ liệu", "Chưa đủ dữ liệu",
						LateValue >= 0.20 || ReviewValue < 3.0 || CancelValue >= 0.02, "Red",
						LateValue > 0.10 || ReviewValue < 4.0 || CancelValue >= 0.01, "Yellow",
						"Green"
					),
					BLANK()
				)
		displayFolder: DSS Threshold Alert
		lineageTag: 62e5439b-3e51-441e-ae63-215a824c8a3e

	/// Lists every breached KPI, not only the KPI determining the worst level.
	measure 'Seller Alert Reason 4.2' =
			VAR AlertLevel = [Seller Alert Level 4.2]
			VAR LateValue = [Seller Late Rate 4.2]
			VAR ReviewValue = [Seller Review Score 4.2]
			VAR CancelValue = [Seller Cancellation Rate 4.2]
			VAR Breaches =
				IF(
					LateValue > 0.10,
					"Late Rate " & FORMAT(LateValue, "0.00%") & IF(LateValue >= 0.20, " >= 20% (Red); ", " > 10% (Yellow); "),
					""
				)
					& IF(
						ReviewValue < 4.0,
						"Review " & FORMAT(ReviewValue, "0.00") & IF(ReviewValue < 3.0, " < 3 (Red); ", " < 4 (Yellow); "),
						""
					)
					& IF(
						CancelValue >= 0.01,
						"Cancellation " & FORMAT(CancelValue, "0.00%") & IF(CancelValue >= 0.02, " >= 2% (Red); ", " >= 1% (Yellow); "),
						""
					)
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(AlertLevel), BLANK(),
					AlertLevel = "Chưa đủ dữ liệu", [Seller Alert Data Status 4.2],
					AlertLevel = "Green", "Trong ngưỡng: Late <= 10%; Review >= 4; Cancellation < 1%",
					LEFT(Breaches, MAX(0, LEN(Breaches) - 2))
				)
		displayFolder: DSS Threshold Alert
		lineageTag: f68e6f85-31e0-4f64-a014-d89d1a5867a0

	measure 'Sellers Red 4.2' =
			COALESCE(
				COUNTROWS(
					FILTER(
						VALUES('DimSeller'[SellerId]),
						NOT ISBLANK('DimSeller'[SellerId])
							&& [Seller Alert Level 4.2] = "Red"
					)
				),
				0
			)
		formatString: 0
		displayFolder: DSS Threshold Alert
		lineageTag: d2f3643e-71cc-4f78-8cab-41337897cbe7

	measure 'Sellers Yellow 4.2' =
			COALESCE(
				COUNTROWS(
					FILTER(
						VALUES('DimSeller'[SellerId]),
						NOT ISBLANK('DimSeller'[SellerId])
							&& [Seller Alert Level 4.2] = "Yellow"
					)
				),
				0
			)
		formatString: 0
		displayFolder: DSS Threshold Alert
		lineageTag: 1eb03d30-4b57-4d44-9ae9-1b060b6a075e

	/// Provisional risk policy: Late 40%, Review 35%, Cancellation 25%; higher means worse.
	/// Excess starts at existing Green boundaries; saturation at Late 30%, Review 2, Cancel 3%.
	measure 'DSS Quality Risk' =
			VAR DataStatus = [Seller Alert Data Status 4.2]
			VAR LateValue = [Seller Late Rate 4.2]
			VAR ReviewValue = [Seller Review Score 4.2]
			VAR CancelValue = [Seller Cancellation Rate 4.2]
			VAR LateRisk = 100 * MIN(1, MAX(0, (LateValue - 0.10) / 0.20))
			VAR ReviewRisk = 100 * MIN(1, MAX(0, (4.0 - ReviewValue) / 2.0))
			VAR CancelRisk = 100 * MIN(1, MAX(0, (CancelValue - 0.01) / 0.02))
			RETURN
				IF(
					DataStatus = "Đủ dữ liệu",
					ROUND(0.40 * LateRisk + 0.35 * ReviewRisk + 0.25 * CancelRisk, 4),
					BLANK()
				)
		formatString: 0.00
		displayFolder: DSS Exception Prioritization
		lineageTag: e638fc06-b476-4d8d-9980-4b90e1ac1041

	/// Selected, alert-data-ready Seller cohort (including Green); P95 cap is provisional.
	/// Evaluate benchmark outside Seller iterators. Zero P95 falls back to cohort maximum.
	measure 'DSS GMV Benchmark' =
			VAR Population =
				CALCULATETABLE(
					ADDCOLUMNS(
						VALUES('DimSeller'[SellerId]),
						"@Status", CALCULATE([Seller Alert Data Status 4.2]),
						"@GMV", CALCULATE([GMV]),
						"@Orders", CALCULATE([Sales Orders])
					),
					ALLSELECTED('DimSeller'[SellerId])
				)
			VAR Eligible =
				FILTER(
					Population,
					NOT ISBLANK('DimSeller'[SellerId]) && [@Status] = "Đủ dữ liệu"
						&& NOT ISBLANK([@GMV]) && [@GMV] >= 0 && [@Orders] > 0
				)
			VAR PercentileValue = PERCENTILEX.INC(Eligible, [@GMV], 0.95)
			RETURN
				IF(
					COUNTROWS(Eligible) > 0,
					IF(PercentileValue > 0, PercentileValue, MAXX(Eligible, [@GMV])),
					BLANK()
				)
		formatString: #,0.00
		displayFolder: DSS Exception Prioritization
		lineageTag: 65398856-c79c-40d0-a956-6cfe07ef0a42

	measure 'DSS Orders Benchmark' =
			VAR Population =
				CALCULATETABLE(
					ADDCOLUMNS(
						VALUES('DimSeller'[SellerId]),
						"@Status", CALCULATE([Seller Alert Data Status 4.2]),
						"@GMV", CALCULATE([GMV]),
						"@Orders", CALCULATE([Sales Orders])
					),
					ALLSELECTED('DimSeller'[SellerId])
				)
			VAR Eligible =
				FILTER(
					Population,
					NOT ISBLANK('DimSeller'[SellerId]) && [@Status] = "Đủ dữ liệu"
						&& NOT ISBLANK([@GMV]) && [@GMV] >= 0 && [@Orders] > 0
				)
			VAR PercentileValue = PERCENTILEX.INC(Eligible, [@Orders], 0.95)
			RETURN
				IF(
					COUNTROWS(Eligible) > 0,
					IF(PercentileValue > 0, PercentileValue, MAXX(Eligible, [@Orders])),
					BLANK()
				)
		formatString: #,0.00
		displayFolder: DSS Exception Prioritization
		lineageTag: 765fb370-6b6a-40cd-9097-aa89cfd94843

	/// Provisional 70% GMV / 30% distinct sales orders. Log normalization capped at selected-cohort P95.
	/// GMV is item Price sum; do not sum order-level GMV or Seller order counts across Sellers.
	measure 'DSS Business Impact' =
			VAR DataStatus = [Seller Alert Data Status 4.2]
			VAR SellerGMV = [GMV]
			VAR SellerOrders = [Sales Orders]
			VAR GMVCap = [DSS GMV Benchmark]
			VAR OrdersCap = [DSS Orders Benchmark]
			VAR GMVImpact = 100 * MIN(1, MAX(0, DIVIDE(LN(1 + MAX(0, SellerGMV)), LN(1 + MAX(0, GMVCap)), 0)))
			VAR OrdersImpact = 100 * MIN(1, MAX(0, DIVIDE(LN(1 + MAX(0, SellerOrders)), LN(1 + MAX(0, OrdersCap)), 0)))
			RETURN
				IF(
					DataStatus = "Đủ dữ liệu"
						&& NOT ISBLANK(SellerGMV) && SellerGMV >= 0 && SellerOrders > 0
						&& NOT ISBLANK(GMVCap) && NOT ISBLANK(OrdersCap),
					ROUND(0.70 * GMVImpact + 0.30 * OrdersImpact, 4),
					BLANK()
				)
		formatString: 0.00
		displayFolder: DSS Exception Prioritization
		lineageTag: 798c73bb-f55d-4bd3-8bf6-e9d6c246bf44

	/// Project assumption, not approved policy: 60% Quality Risk / 40% Business Impact.
	measure 'DSS Priority Score' =
			VAR AlertLevel = [Seller Alert Level 4.2]
			VAR RiskValue = [DSS Quality Risk]
			VAR ImpactValue = [DSS Business Impact]
			RETURN
				IF(
					AlertLevel IN {"Red", "Yellow"}
						&& NOT ISBLANK(RiskValue) && NOT ISBLANK(ImpactValue),
					ROUND(0.60 * RiskValue + 0.40 * ImpactValue, 4),
					BLANK()
				)
		formatString: 0.00
		displayFolder: DSS Exception Prioritization
		lineageTag: b70e8f28-898d-48a0-ab12-e5e7169bb245

	/// Benchmarks captured before iterators to avoid nested ALLSELECTED shadow-context changes.
	/// Integer sort key: Red offset 1000001 > maximum Yellow ticks 1000000; ties use DENSE.
	measure 'DSS Priority Rank' =
			VAR CurrentPriority = [DSS Priority Score]
			VAR CurrentAlert = [Seller Alert Level 4.2]
			VAR GMVCap = [DSS GMV Benchmark]
			VAR OrdersCap = [DSS Orders Benchmark]
			VAR Population =
				ADDCOLUMNS(
					ALLSELECTED('DimSeller'[SellerId]),
					"@Alert", CALCULATE([Seller Alert Level 4.2]),
					"@Risk", CALCULATE([DSS Quality Risk]),
					"@GMV", CALCULATE([GMV]),
					"@Orders", CALCULATE([Sales Orders])
				)
			VAR Eligible =
				FILTER(
					Population,
					NOT ISBLANK('DimSeller'[SellerId]) && [@Alert] IN {"Red", "Yellow"}
						&& NOT ISBLANK([@Risk]) && NOT ISBLANK([@GMV]) && [@GMV] >= 0 && [@Orders] > 0
				)
			VAR Candidates =
				ADDCOLUMNS(
					Eligible,
					"@PriorityKey",
						VAR GMVImpact = 100 * MIN(1, MAX(0, DIVIDE(LN(1 + MAX(0, [@GMV])), LN(1 + MAX(0, GMVCap)), 0)))
						VAR OrdersImpact = 100 * MIN(1, MAX(0, DIVIDE(LN(1 + MAX(0, [@Orders])), LN(1 + MAX(0, OrdersCap)), 0)))
						VAR ImpactValue = ROUND(0.70 * GMVImpact + 0.30 * OrdersImpact, 4)
						VAR PriorityValue = ROUND(0.60 * [@Risk] + 0.40 * ImpactValue, 4)
						RETURN IF([@Alert] = "Red", 1000001, 0) + ROUND(PriorityValue * 10000, 0)
				)
			VAR CurrentKey = IF(CurrentAlert = "Red", 1000001, 0) + ROUND(CurrentPriority * 10000, 0)
			RETURN
				IF(
					ISINSCOPE('DimSeller'[SellerId]) && HASONEVALUE('DimSeller'[SellerId])
						&& NOT ISBLANK(CurrentPriority) && NOT ISBLANK(GMVCap) && NOT ISBLANK(OrdersCap),
					RANKX(Candidates, [@PriorityKey], CurrentKey, DESC, DENSE),
					BLANK()
				)
		formatString: 0
		displayFolder: DSS Exception Prioritization
		lineageTag: dcb7c017-c411-4562-bef1-f818c242c946

	measure 'DSS Intervention Level' =
			VAR AlertLevel = [Seller Alert Level 4.2]
			VAR SellerGMV = [GMV]
			VAR SellerOrders = [Sales Orders]
			RETURN
				IF(
					NOT ISBLANK(AlertLevel),
					SWITCH(
						TRUE(),
						AlertLevel = "Chưa đủ dữ liệu" || ISBLANK(SellerGMV) || SellerGMV < 0 || ISBLANK(SellerOrders) || SellerOrders <= 0, "Kiểm tra dữ liệu",
						AlertLevel = "Red", "Ưu tiên kiểm tra",
						AlertLevel = "Yellow", "Theo dõi và kiểm tra",
						"Theo dõi thường kỳ"
					),
					BLANK()
				)
		displayFolder: DSS Exception Prioritization
		lineageTag: e7e974ad-6ddd-46b6-80e4-b69f340e8047

	/// Evidence-based checks only: no causal attribution or automatic restriction.
	measure 'DSS Recommended Intervention' =
			VAR InterventionLevel = [DSS Intervention Level]
			VAR LateValue = [Seller Late Rate 4.2]
			VAR ReviewValue = [Seller Review Score 4.2]
			VAR CancelValue = [Seller Cancellation Rate 4.2]
			VAR Checks =
				IF(CancelValue >= 0.01, "Kiểm tra tỷ lệ hủy đơn và đối soát trạng thái đơn; ", "")
					& IF(LateValue > 0.10, "Rà soát quy trình giao hàng và các đơn giao trễ; ", "")
					& IF(ReviewValue < 4.0, "Kiểm tra phản hồi đánh giá và chất lượng trải nghiệm; ", "")
			RETURN
				SWITCH(
					TRUE(),
					ISBLANK(InterventionLevel), BLANK(),
					InterventionLevel = "Kiểm tra dữ liệu",
						IF(
							[Seller Alert Level 4.2] = "Chưa đủ dữ liệu",
							"Kiểm tra dữ liệu: " & [Seller Alert Reason 4.2],
							"Kiểm tra dữ liệu GMV và số đơn; chưa xếp ưu tiên"
						),
					InterventionLevel = "Theo dõi thường kỳ", "Theo dõi chất lượng Seller theo kỳ",
					LEFT(Checks, MAX(0, LEN(Checks) - 2))
				)
		displayFolder: DSS Exception Prioritization
		lineageTag: 35b3a833-4fb9-4fe7-b293-0fd1f9306c48

	/// Count eligible exceptions without evaluating cohort-normalized scores inside a Seller iterator.
	measure 'DSS Sellers Requiring Action' =
			COALESCE(
				COUNTROWS(
					FILTER(
						VALUES('DimSeller'[SellerId]),
						NOT ISBLANK('DimSeller'[SellerId])
							&& [Seller Alert Level 4.2] IN {"Red", "Yellow"}
							&& NOT ISBLANK([GMV]) && [GMV] >= 0 && [Sales Orders] > 0
					)
				),
				0
			)
		formatString: 0
		displayFolder: DSS Exception Prioritization
		lineageTag: 14c784a3-67ef-4496-8ea0-c3bdd8f8de49

	/// Sellers active in the current Item slice only; no-sale dimension members are not data exceptions.
	measure 'DSS Sellers Data Review' =
			COALESCE(
				COUNTROWS(
					FILTER(
						VALUES('DimSeller'[SellerId]),
						NOT ISBLANK('DimSeller'[SellerId]) && [Sales Orders] > 0
							&& [DSS Intervention Level] = "Kiểm tra dữ liệu"
					)
				),
				0
			)
		formatString: 0
		displayFolder: DSS Exception Prioritization
		lineageTag: 10657841-d630-460a-a871-1fb782165a50

	/// Report support only: average the current validated score once per eligible Seller.
	measure 'DSS Average Seller Score' =
			AVERAGEX(
				FILTER(VALUES('DimSeller'[SellerId]), NOT ISBLANK('DimSeller'[SellerId])),
				[Seller Score 4.2]
			)
		formatString: 0.0
		displayFolder: DSS Report Support
		lineageTag: 11775646-9370-4725-afce-ac222812bd81

	/// GradeBand is disconnected; explicitly count the new performance grade, not legacy Grade.
	measure 'DSS Sellers by Performance Grade' =
			VAR SelectedGrade = SELECTEDVALUE('GradeBand'[Grade])
			RETURN
				IF(
					NOT ISBLANK(SelectedGrade),
					COALESCE(
						COUNTROWS(
							FILTER(
								VALUES('DimSeller'[SellerId]),
								NOT ISBLANK('DimSeller'[SellerId])
									&& [Seller Grade 4.2] = SelectedGrade
							)
						),
						0
					)
				)
		formatString: #,0
		displayFolder: DSS Report Support
		lineageTag: e74de183-921b-4428-a89b-4a7b6db23982

	/// Alert distribution includes active Sellers only; no-sale dimension members are excluded.
	measure 'DSS Sellers by Alert Level' =
			VAR SelectedLevel = SELECTEDVALUE('DSSAlertBand'[AlertLevel])
			RETURN
				IF(
					NOT ISBLANK(SelectedLevel),
					COALESCE(
						COUNTROWS(
							FILTER(
								VALUES('DimSeller'[SellerId]),
								NOT ISBLANK('DimSeller'[SellerId]) && [Sales Orders] > 0
									&& [Seller Alert Level 4.2] = SelectedLevel
							)
						),
						0
					)
				)
		formatString: #,0
		displayFolder: DSS Report Support
		lineageTag: 02d969bc-1fe7-4717-b01c-fffd2e6bb783

	measure 'DSS Performance Color' =
			SWITCH(
				[Seller Grade 4.2],
				"A", "#2E7D32",
				"B", "#1E3A8A",
				"C", "#B77900",
				"D", "#D64545",
				"#6B7390"
			)
		displayFolder: DSS Report Support
		lineageTag: aea66ca0-6e27-4084-96dd-205fe681c584

	measure 'DSS Alert Color' =
			SWITCH(
				[Seller Alert Level 4.2],
				"Green", "#2E7D32",
				"Yellow", "#B77900",
				"Red", "#D64545",
				"#6B7390"
			)
		displayFolder: DSS Report Support
		lineageTag: a4c27edc-8723-4f40-a491-7b862a9c0085

	/// Report-only helper: actual nonblank accepted scores, not just legacy volume eligibility.
	measure 'DSS Eligible Sellers' =
			COALESCE(
				COUNTROWS(
					FILTER(
						VALUES('DimSeller'[SellerId]),
						NOT ISBLANK('DimSeller'[SellerId]) && NOT ISBLANK([Seller Score 4.2])
					)
				),
				0
			)
		formatString: #,0
		displayFolder: DSS Report Support
		lineageTag: 764bf795-c231-4cbf-923a-184cb337dc71

	/// Display translation only; the accepted Alert Level and its thresholds are unchanged.
	measure 'DSS Alert Label' =
			SWITCH(
				[Seller Alert Level 4.2],
				"Green", "Bình thường",
				"Yellow", "Cần theo dõi",
				"Red", "Rủi ro cao",
				"Chưa đủ dữ liệu", "Chưa đủ dữ liệu",
				BLANK()
			)
		displayFolder: DSS Report Support
		lineageTag: be5b118f-5ef7-4b40-b31f-2898ea34cc72

	/// A disconnected legend must gate X and Y; otherwise each Seller repeats in every color.
	measure 'DSS Scatter Quality Risk' =
			VAR LegendLevel = SELECTEDVALUE('DSSAlertBand'[AlertLevel])
			VAR ActualLevel = [Seller Alert Level 4.2]
			RETURN
				IF(
					ActualLevel IN {"Red", "Yellow"} && LegendLevel = ActualLevel
						&& NOT ISBLANK([DSS Priority Score]),
					[DSS Quality Risk],
					BLANK()
				)
		formatString: 0.00
		displayFolder: DSS Report Support
		lineageTag: f60c9664-53ab-4456-bb9a-4873ddfc2b73

	measure 'DSS Scatter Business Impact' =
			VAR LegendLevel = SELECTEDVALUE('DSSAlertBand'[AlertLevel])
			VAR ActualLevel = [Seller Alert Level 4.2]
			RETURN
				IF(
					ActualLevel IN {"Red", "Yellow"} && LegendLevel = ActualLevel
						&& NOT ISBLANK([DSS Priority Score]),
					[DSS Business Impact],
					BLANK()
				)
		formatString: 0.00
		displayFolder: DSS Report Support
		lineageTag: 6f553206-5466-41c4-9d77-52ddcf45ed74

	/// Presentation only: two or more breached KPIs are reported as multiple issues, not a root cause.
	measure 'DSS Main Issue' =
			VAR Ready = [Seller Alert Data Status 4.2] = "Đủ dữ liệu"
			VAR LateFlag = IF([Seller Late Rate 4.2] > 0.10, 1, 0)
			VAR ReviewFlag = IF([Seller Review Score 4.2] < 4.0, 1, 0)
			VAR CancelFlag = IF([Seller Cancellation Rate 4.2] >= 0.01, 1, 0)
			RETURN
				IF(
					HASONEVALUE('DimSeller'[SellerId]),
					SWITCH(
						TRUE(),
						NOT Ready, "Kiểm tra dữ liệu",
						LateFlag + ReviewFlag + CancelFlag >= 2, "Nhiều chỉ số bất thường",
						CancelFlag = 1, "Tỷ lệ hủy cao",
						LateFlag = 1, "Giao trễ cao",
						ReviewFlag = 1, "Đánh giá thấp",
						"Trong ngưỡng"
					)
				)
		displayFolder: DSS Report Support
		lineageTag: 7405fdf8-8d68-43c8-88c3-d2f935644261

	/// Alert eligibility, not score eligibility. Preserve Date/Category/Seller geography filters.
	/// Ignore disconnected Alert labels so the denominator cannot shrink to the Red subset.
	measure 'DSS Alert Eligible Sellers' =
			CALCULATE(
				COALESCE(
					COUNTROWS(
						FILTER(
							VALUES('DimSeller'[SellerId]),
							NOT ISBLANK('DimSeller'[SellerId])
								&& [Seller Alert Data Status 4.2] = "Đủ dữ liệu"
						)
					),
					0
				),
				REMOVEFILTERS('DSSAlertBand')
			)
		formatString: #,0
		displayFolder: DSS Report Support
		lineageTag: 51c92645-b44e-4ef1-99fc-f1e783f51e62

	measure 'DSS Red Seller Rate' =
			DIVIDE(
				CALCULATE([Sellers Red 4.2], REMOVEFILTERS('DSSAlertBand')),
				[DSS Alert Eligible Sellers]
			)
		formatString: 0.0%
		displayFolder: DSS Report Support
		lineageTag: f8c40535-c772-4140-b937-8c6c111a6163

	/// Display-only policy: at least 10 eligible Sellers per state; requires group confirmation.
	/// Exact Top 5 uses rate DESC, sample size DESC, StateCode ASC. Does not change Seller Dense Rank.
	measure 'DSS State Alert Rank' =
			VAR CurrentState = SELECTEDVALUE('SellerGeography'[StateCode])
			VAR CurrentRate = [DSS Red Seller Rate]
			VAR CurrentSample = [DSS Alert Eligible Sellers]
			VAR Population =
				FILTER(
					ADDCOLUMNS(
						ALLSELECTED('SellerGeography'[StateCode]),
						"@Rate", CALCULATE([DSS Red Seller Rate]),
						"@Sample", CALCULATE([DSS Alert Eligible Sellers])
					),
					NOT ISBLANK('SellerGeography'[StateCode]) && [@Sample] >= 10 && NOT ISBLANK([@Rate])
				)
			VAR BeforeCurrent =
				COUNTROWS(
					FILTER(
						Population,
						[@Rate] > CurrentRate
							|| ([@Rate] = CurrentRate && [@Sample] > CurrentSample)
							|| ([@Rate] = CurrentRate && [@Sample] = CurrentSample && 'SellerGeography'[StateCode] < CurrentState)
					)
				)
			RETURN
				IF(
					ISINSCOPE('SellerGeography'[StateCode]) && NOT ISBLANK(CurrentState)
						&& CurrentSample >= 10 && NOT ISBLANK(CurrentRate),
					1 + COALESCE(BeforeCurrent, 0)
				)
		formatString: 0
		displayFolder: DSS Report Support
		lineageTag: b741c7a8-bbbb-4f40-8cf7-0e363f595d64

	/// Dedicated to section 4.2; no model, ETL or shared KPI changes.
	measure 'Seller Score Data Status 4.2' =
			VAR SingleSeller = HASONEVALUE('DimSeller'[SellerId]) && NOT ISBLANK(SELECTEDVALUE('DimSeller'[SellerId]))
			VAR SalesOrders = [Sales Orders]
			VAR DeliveredOrders = [Delivered Orders (Item)]
			VAR ReviewValue = [Seller Review Score 4.2]
			VAR HandoverValue = [Handover On-time %]
			VAR InvalidReviewRows = COUNTROWS(FILTER('FactOrderItem', NOT ISBLANK('FactOrderItem'[ReviewScore]) && ('FactOrderItem'[ReviewScore] < 1 || 'FactOrderItem'[ReviewScore] > 5)))
			VAR InvalidHandoverRows = COUNTROWS(FILTER('FactOrderItem', NOT ISBLANK('FactOrderItem'[HandoverOnTime]) && NOT ('FactOrderItem'[HandoverOnTime] IN {0, 1})))
			VAR InvalidDelayRows = COUNTROWS(FILTER('FactOrderItem', NOT ISBLANK('FactOrderItem'[IsOnTime]) && (ISBLANK('FactOrderItem'[DelayDays]) || 'FactOrderItem'[DelayDays] < 0 || ('FactOrderItem'[IsOnTime] == FALSE() && 'FactOrderItem'[DelayDays] <= 0) || ('FactOrderItem'[IsOnTime] == TRUE() && 'FactOrderItem'[DelayDays] > 0))))
			VAR Reasons =
			    IF(COALESCE(SalesOrders, 0) = 0, "Không có đơn có item; ", "")
			    & IF(COALESCE(DeliveredOrders, 0) < 30, "Dưới 30 đơn đủ thông tin OTD; ", "")
			    & IF(ISBLANK(ReviewValue), "Thiếu đánh giá; ", "")
			    & IF(COALESCE(InvalidReviewRows, 0) > 0, "Review ngoài khoảng 1-5; ", "")
			    & IF(ISBLANK(HandoverValue), "Thiếu dữ liệu bàn giao; ", "")
			    & IF(COALESCE(InvalidHandoverRows, 0) > 0, "Bàn giao ngoài mã 0/1; ", "")
			    & IF(COALESCE(InvalidDelayRows, 0) > 0, "DelayDays thiếu hoặc mâu thuẫn OTD; ", "")
			    & IF(ISBLANK([Seller Cancellation Rate 4.2]), "Thiếu trạng thái đơn; ", "")
			RETURN IF(SingleSeller, IF(Reasons = "", "Đủ dữ liệu", LEFT(Reasons, LEN(Reasons) - 2)))
		displayFolder: DSS Report Support
		lineageTag: 10813877-503e-4bdc-b330-6cd8b839afd6

	/// Dedicated to section 4.2; no model, ETL or shared KPI changes.
	measure 'Seller Reviewed Orders 4.2' = CALCULATE(DISTINCTCOUNT('FactOrderItem'[OrderId]), KEEPFILTERS(NOT ISBLANK('FactOrderItem'[ReviewScore])))
		formatString: #,0
		displayFolder: DSS Report Support
		lineageTag: 5be58705-c71b-480a-b2d2-d9677dac03d7

	/// Dedicated to section 4.2; no model, ETL or shared KPI changes.
	measure 'Seller Handover Coverage 4.2' = DIVIDE(CALCULATE(COUNTROWS('FactOrderItem'), KEEPFILTERS(NOT ISBLANK('FactOrderItem'[HandoverOnTime]))), COUNTROWS('FactOrderItem'))
		formatString: 0.0%
		displayFolder: DSS Report Support
		lineageTag: 12b96d90-566c-4bc5-aecc-c488d9ab4637

	/// Dedicated to section 4.2; no model, ETL or shared KPI changes.
	measure 'DSS Score Data Review 4.2' = COALESCE(COUNTROWS(FILTER(VALUES('DimSeller'[SellerId]), NOT ISBLANK('DimSeller'[SellerId]) && [Sales Orders] > 0 && ISBLANK([Seller Score 4.2]))), 0)
		formatString: #,0
		displayFolder: DSS Report Support
		lineageTag: 032c1f1b-e4b8-4217-8c9e-f72d467ba346

	/// Section 4.2 only: Red or Yellow / all alert-eligible Sellers; zero denominator returns BLANK.
	measure 'DSS Alert Rate 4.2' = DIVIDE(CALCULATE([Sellers Red 4.2] + [Sellers Yellow 4.2], REMOVEFILTERS('DSSAlertBand')), [DSS Alert Eligible Sellers])
		formatString: 0.0%
		displayFolder: DSS Threshold Alert
		lineageTag: 717d9407-ff65-493a-895b-d34a5f0bc07b

	/// Project policy approved for section 4.2 only; not an industry standard.
	/// Score eligibility first; missing Alert does not imply Green. Totals return BLANK.
	measure 'Seller Action Group 4.2' =
			VAR SingleSeller = HASONEVALUE('DimSeller'[SellerId]) && NOT ISBLANK(SELECTEDVALUE('DimSeller'[SellerId]))
			VAR ScoreValue = [Seller Score 4.2]
			VAR GradeValue = [Seller Grade 4.2]
			VAR AlertValue = [Seller Alert Level 4.2]
			RETURN
				IF(
					SingleSeller,
					SWITCH(
						TRUE(),
						ISBLANK(ScoreValue), "Not Scored",
						AlertValue = "Red" || GradeValue = "D", "Investigate",
						AlertValue = "Yellow" || GradeValue = "C", "Warning",
						GradeValue = "B" && AlertValue = "Green", "Support",
						GradeValue = "A" && AlertValue = "Green", "Maintain",
						BLANK()
					),
					BLANK()
				)
		displayFolder: DSS Seller Ranking
		lineageTag: cb84a09b-4dd4-4e4d-bac7-0919a2fb4a4d

	measure 'DSS Grade Alert Sellers 4.2' =
			VAR Grades = VALUES(GradeBand[Grade])
			VAR Alerts = VALUES(DSSAlertBand[AlertLevel])
			RETURN COALESCE(COUNTROWS(FILTER(VALUES(DimSeller[SellerId]),
			NOT ISBLANK(DimSeller[SellerId]) && [Sales Orders] > 0
			&& [Seller Grade 4.2] IN {"A","B","C","D"}
			&& [Seller Alert Level 4.2] IN {"Green","Yellow","Red"}
			&& [Seller Grade 4.2] IN Grades
			&& [Seller Alert Level 4.2] IN Alerts)),0)
		formatString: #,0
		displayFolder: DSS Heatmap 4.2
		lineageTag: ba92177b-5798-4766-af5d-99c175a72c91

	measure 'DSS Grade Alert Heatmap Color 4.2' =
			VAR CellCount = [DSS Grade Alert Sellers 4.2]
			VAR AlertBandValue = SELECTEDVALUE(DSSAlertBand[AlertLevel])
			VAR Peak = MAXX(ALL(GradeBand), CALCULATE([DSS Grade Alert Sellers 4.2]))
			VAR Intensity = DIVIDE(CellCount, Peak, 0)
			RETURN
			IF(NOT ISINSCOPE(GradeBand[Grade]) || NOT ISINSCOPE(DSSAlertBand[AlertLevel]), "#E6EAF5",
			IF(CellCount = 0, "#F5F5FD",
			SWITCH(AlertBandValue,
			"Green", SWITCH(TRUE(), Intensity >= 0.6, "#91B4DB", Intensity >= 0.25, "#C3D7ED", "#E3EDF8"),
			"Yellow", SWITCH(TRUE(), Intensity >= 0.6, "#F2D98C", Intensity >= 0.25, "#F7E6B2", "#FBF3D9"),
			"Red", SWITCH(TRUE(), Intensity >= 0.6, "#E9AAAA", Intensity >= 0.25, "#F1CBCB", "#F9E5E5"),
			"#F5F5FD")))
		displayFolder: DSS Heatmap 4.2
		lineageTag: c4fa2ba2-f13d-4840-9f60-c79865cece08

	measure 'DSS Alert Share within Grade 4.2' =
			DIVIDE(
				[DSS Grade Alert Sellers 4.2],
				CALCULATE([DSS Grade Alert Sellers 4.2], REMOVEFILTERS(DSSAlertBand)),
				0
			)
		formatString: 0.0%
		displayFolder: DSS Report Support
		lineageTag: 6b0a3421-49cd-45dd-b49e-4613f321c59e

	measure 'BQ4 GMV 2017 Jan-Aug' = CALCULATE([GMV], REMOVEFILTERS('DimDate'), 'DimDate'[YearNumber] = 2017, 'DimDate'[MonthNumber] >= 1, 'DimDate'[MonthNumber] <= 8)
		formatString: #,0
		lineageTag: fb8e0320-f3bc-4cc8-bfc4-05d43d5979c1

	measure 'BQ4 GMV 2018 Jan-Aug' = CALCULATE([GMV], REMOVEFILTERS('DimDate'), 'DimDate'[YearNumber] = 2018, 'DimDate'[MonthNumber] >= 1, 'DimDate'[MonthNumber] <= 8)
		formatString: #,0
		lineageTag: 61d075af-530f-42ba-9218-e24c5d15f6ad

	measure 'BQ4 Reviewed Orders 2018 Jan-Aug' = CALCULATE(COUNTROWS(FILTER(VALUES('FactOrderItem'[OrderId]), NOT ISBLANK(CALCULATE(MAX('FactOrderItem'[ReviewScore]))))), REMOVEFILTERS('DimDate'), 'DimDate'[YearNumber] = 2018, 'DimDate'[MonthNumber] >= 1, 'DimDate'[MonthNumber] <= 8)
		formatString: #,0
		lineageTag: 6171c6b4-dcb9-427f-97e9-f222ab2aa457

	measure 'BQ4 Review 2018 Jan-Aug' = CALCULATE([Review (Item)], REMOVEFILTERS('DimDate'), 'DimDate'[YearNumber] = 2018, 'DimDate'[MonthNumber] >= 1, 'DimDate'[MonthNumber] <= 8)
		formatString: 0.000
		lineageTag: 70b51c96-85ab-4099-a5e1-b449c8b1f4a6

	measure 'BQ4 GMV Growth %' = VAR PriorGMV = [BQ4 GMV 2017 Jan-Aug] VAR CurrentGMV = [BQ4 GMV 2018 Jan-Aug] VAR Reviews = [BQ4 Reviewed Orders 2018 Jan-Aug] RETURN IF(PriorGMV >= 10000 && CurrentGMV >= 20000 && Reviews >= 100, DIVIDE(CurrentGMV - PriorGMV, PriorGMV))
		formatString: 0.00%
		lineageTag: 4a8c6a58-5eb6-440a-a79f-a15913a06813

